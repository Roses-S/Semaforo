# Plantilla de configuración. Copia este archivo como ".env" y pon tus datos reales.
# El .env NO se sube a GitHub (está en .gitignore); este .env.example sí, sin secretos.

# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql+psycopg://semaforo_app:cambia_esta_clave@localhost:5432/semaforo
DATABASE_URL_TEST=postgresql+psycopg://semaforo_app:cambia_esta_clave@localhost:5432/semaforo_test
